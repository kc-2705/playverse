# Copy this file to .env and fill it in. `npm run demo` needs none of this.
PORT=4000
# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGO_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/playverse
# Any long random string, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Where the web app runs; separate several with commas
CLIENT_URL=http://localhost:5174
